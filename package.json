{
  "name": "fengzaiy",
  "version": "0.1.15",
  "private": true,
  "license": "UNLICENSED",
  "description": "FengZaiY personal management system with local encrypted synchronization",
  "type": "module",
  "main": "src/desktop/main.mjs",
  "fengzaiyUpdateSource": {
    "provider": "github",
    "owner": "FengZaiY",
    "repo": "Project02_StudySelf",
    "private": false,
    "releaseType": "release"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "start": "npm run build && electron .",
    "dev": "node src/server.mjs",
    "check:project": "node scripts/check-project.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:personal": "node scripts/test-personal-ui.mjs",
    "test:personal-desktop": "node scripts/test-personal-desktop.mjs",
    "test:ui": "node scripts/test-ui.mjs",
    "test:startup": "node scripts/test-startup-ui.mjs",
    "test:devices": "node scripts/test-devices-ui.mjs",
    "test:libraries": "node scripts/test-libraries-ui.mjs",
    "test:assets": "node scripts/test-assets-ui.mjs",
    "test:attachments": "node scripts/test-note-attachments.mjs",
    "test:attachment-drag": "node scripts/test-attachment-drag.mjs",
    "test:dedup": "node scripts/test-asset-dedup.mjs",
    "test:asset-previews": "node scripts/test-asset-previews.mjs",
    "test:asset-storage": "node scripts/test-asset-storage.mjs",
    "test:readable-storage": "node scripts/test-readable-storage-ui.mjs",
    "test:hierarchy": "node scripts/test-hierarchy-ui.mjs",
    "test:note-drag": "node scripts/test-note-tree-drag.mjs",
    "test:agents": "node scripts/test-agents-ui.mjs",
    "test:agent-operations": "node scripts/test-agent-operations-ui.mjs",
    "test:agent-operations-desktop": "node scripts/test-agent-operations-desktop.mjs",
    "test:skills": "node scripts/test-skill-manager.mjs",
    "test:updates": "node scripts/test-updates-ui.mjs",
    "test:updates-desktop": "node scripts/test-update-download-desktop.mjs",
    "test:drafts": "node scripts/test-draft-workflow.mjs",
    "test:rich": "node scripts/test-rich-ui.mjs",
    "test:retired-reading": "node scripts/test-retired-reading.mjs",
    "test:mindmap": "node scripts/test-mindmap-ui.mjs",
    "test:rich-layout": "node scripts/test-rich-layout.mjs",
    "test:line-drag": "node scripts/test-block-line-drag.mjs",
    "test:horizontal-drag": "node scripts/test-horizontal-drag.mjs",
    "test:docx-preview": "node scripts/test-docx-preview.mjs",
    "test:editor": "node scripts/test-editor-interactions.mjs",
    "test:experience": "node scripts/test-editor-experience.mjs",
    "test:shortcuts": "node scripts/test-edit-shortcuts.mjs",
    "test:shortcuts-desktop": "node scripts/test-edit-shortcuts.mjs --desktop",
    "test:code-blocks": "node scripts/test-code-blocks-ui.mjs",
    "test:code-paste": "node scripts/test-code-paste-ui.mjs",
    "test:code-paste-desktop": "node scripts/test-code-paste-ui.mjs --desktop",
    "test:trash": "node scripts/test-trash-ui.mjs",
    "test:document": "node scripts/test-document-flow.mjs",
    "test:storage": "node scripts/test-storage-ui.mjs",
    "test:desktop": "node scripts/test-desktop.mjs",
    "test:exit": "node scripts/test-exit-ui.mjs",
    "test:audit-fixes": "node scripts/test-audit-fixes-desktop.mjs",
    "test:sync-publication": "node scripts/test-sync-publication-ui.mjs",
    "test:sync-ui": "node scripts/test-sync-ui.mjs",
    "test:packaged": "node scripts/test-desktop.mjs --packaged",
    "benchmark": "node scripts/benchmark.mjs",
    "dist": "npm run build && electron-builder --config scripts/release-config.mjs --win nsis --x64 --publish never"
  },
  "devDependencies": {
    "@tiptap/core": "^3.31.4",
    "@tiptap/extension-highlight": "^3.31.4",
    "@tiptap/extension-table": "^3.31.4",
    "@tiptap/extension-task-item": "^3.31.4",
    "@tiptap/extension-task-list": "^3.31.4",
    "@tiptap/starter-kit": "^3.31.4",
    "d3-hierarchy": "3.1.2",
    "dompurify": "^3.3.0",
    "electron": "^42.0.0",
    "electron-builder": "^26.0.0",
    "esbuild": "^0.27.0",
    "jszip": "3.10.1",
    "katex": "^0.19.0",
    "konva": "^10.7.1",
    "lucide": "^0.468.0",
    "mammoth": "1.13.0",
    "mermaid": "^12.1.0",
    "playwright": "^1.58.0"
  },
  "overrides": {
    "mermaid": {
      "katex": "$katex"
    }
  },
  "build": {
    "appId": "cn.fengzaiy.desktop",
    "productName": "FengZaiY",
    "directories": {
      "output": "release"
    },
    "files": [
      "src/core/**/*",
      "src/desktop/**/*",
      "skills/fengzaiy/**/*",
      "dist/**/*",
      "package.json"
    ],
    "asar": true,
    "win": {
      "target": "nsis",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "deleteAppDataOnUninstall": false,
      "artifactName": "FengZaiY-${version}-Setup.${ext}",
      "guid": "7457b9bb-d48d-5e54-9394-6a2683571810"
    }
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "builder-util-runtime": "9.7.0",
    "electron-updater": "6.6.2",
    "marked": "^17.0.6",
    "parse5": "^8.0.1",
    "turndown": "^7.2.4",
    "turndown-plugin-gfm": "^1.0.2",
    "zod": "4.6.7"
  }
}
